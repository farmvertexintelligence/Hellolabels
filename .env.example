# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hellolabels.in
# WhatsApp click-to-chat number (country code, no +), e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Supabase (database, phone OTP login, file storage) ───────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay (UPI, cards, net banking, wallets) ──────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://<site>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ── AI label designer (Claude) ───────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
AI_DESIGN_MODEL=

# ── Dealer KYC: 32 random bytes, base64.  openssl rand -base64 32 ────
# Keep a secure offline backup: encrypted Aadhaar files cannot be read without it.
AADHAAR_ENCRYPTION_KEY=

# ── Order updates ────────────────────────────────────────────────────
# MSG91 Flow API (DLT-approved template with variables var1..var4)
MSG91_AUTH_KEY=
MSG91_ORDER_STATUS_TEMPLATE_ID=
# WhatsApp Cloud API (approved template "order_status_update", 4 body variables, en + ta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_STATUS_TEMPLATE=order_status_update

# ── Cron (Vercel sends it as a Bearer token) ─────────────────────────
CRON_SECRET=
